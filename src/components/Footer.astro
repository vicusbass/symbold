---
import Facebook from '../assets/footer/facebook.svg';
import Instagram from '../assets/footer/instagram.svg';
import LinkedIn from '../assets/footer/linkedin.svg';
import YouTube from '../assets/footer/youtube.svg';
---

<footer
  class="content-padding flex flex-col items-center gap-6 py-8 md:flex-row md:justify-between md:pb-24"
>
  <div class="flex flex-col items-center gap-4 md:flex-row md:gap-6">
    <span class="text-sm text-gray-600">Follow us</span>
    <div class="flex gap-4">
      <a
        href="https://www.facebook.com/symboldstudio/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Facebook"
        class="text-black hover:opacity-70"
      >
        <Facebook class="h-6 w-6" />
      </a>
      <a
        href="https://www.linkedin.com/company/symboldstudio/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="text-black hover:opacity-70"
      >
        <LinkedIn class="h-6 w-6" />
      </a>
      <!-- biome-ignore lint/a11y/useValidAnchor: placeholder until the YouTube channel URL is known -->
      <a href="#" aria-label="YouTube" class="text-black hover:opacity-70">
        <YouTube class="h-6 w-6" />
      </a>
      <a
        href="https://www.instagram.com/symboldbrands/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
        class="text-black hover:opacity-70"
      >
        <Instagram class="h-6 w-6" />
      </a>
    </div>
  </div>

  <div class="text-center text-sm text-gray-600 md:text-left">© Copyright Symbold 2025</div>

  <nav class="flex flex-col items-center gap-3 text-sm text-gray-600 md:flex-row md:gap-6">
    <a href="/terms" class="hover:text-black"> Terms & Conditions </a>
    <a href="/cookie-policy" class="hover:text-black"> Cookie Policy </a>
    <a href="/privacy" class="hover:text-black"> Privacy Policy </a>
  </nav>
</footer>
