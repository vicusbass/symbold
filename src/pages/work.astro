---
import { sanityClient } from 'sanity:client';
import type { SanityDocument } from '@sanity/client';
import BaselineReveal from '../components/BaselineReveal.astro';
import Button from '../components/Button.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import RightReveal from '../components/RightReveal.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import Tag from '../components/Tag.astro';
import Layout from '../layouts/Layout.astro';
import { portfolioListQuery } from '../lib/queries/portfolio';

const TAGS_QUERY = `*[_type == "tag"]{ id, text, hoverColor, order } | order(order asc)`;

const tagsData = await sanityClient.fetch<SanityDocument[]>(TAGS_QUERY);
const portfolioData = await sanityClient.fetch<SanityDocument[]>(portfolioListQuery);

const tags = tagsData.map((tag) => ({
  id: tag.id.current,
  label: tag.text,
  hoverColor: tag.hoverColor,
}));

// Transform Sanity portfolio data to match the FeaturedProject format
const projects = portfolioData.map((project) => ({
  project: {
    _id: project._id,
    title: project.title,
    slug: project.slug.current,
    hero: project.hero,
  },
  tags: project.tags?.map((tag: any) => tag.id.current) || [],
}));
---

<Layout
  title="Portfolio | Branding & Web Design Projects | Symbold"
  description="Explore our branding and web design portfolio — bold brand identities, packaging, and digital experiences. Proiecte de branding și identitate vizuală."
  schema={{
    '@type': 'CollectionPage',
    name: 'Portfolio',
    description:
      'Branding and web design portfolio — bold brand identities, packaging, and digital experiences.',
    url: 'https://symbold.ro/work',
    publisher: { '@id': 'https://symbold.ro/#organization' },
    hasPart: projects.map((item) => ({
      '@type': 'CreativeWork',
      name: item.project.title,
      url: `https://symbold.ro/work/${item.project.slug}`,
    })),
  }}
>
  <section id="headers" class="content-padding">
    <BaselineReveal>
      <h1 class="page-title">
        brands
        <br />
        we're proud of
      </h1>
    </BaselineReveal>
    <BaselineReveal delayed>
      <div class="mt-20 py-1 text-base font-normal md:mt-20 md:text-2xl">
        Browse work by service
      </div>
    </BaselineReveal>

    <div class="mt-10 flex flex-wrap gap-4">
      <RightReveal index={0}>
        <Tag id="all" label="All" active={true} />
      </RightReveal>
      {tags.map((tag, index) => (
        <RightReveal index={index + 1}>
          <Tag id={tag.id} label={tag.label} active={false} hoverColor={tag.hoverColor} />
        </RightReveal>
      ))}
    </div>
  </section>

  <div class="edge-padding mt-20 flex flex-row flex-wrap md:mt-30">
    {projects.map((item, index) => {
      let rowNumber = 0;
      let itemsProcessed = 0;
      let tempIndex = index;

      while (tempIndex >= 0) {
        const itemsInRow = rowNumber % 2 === 0 ? 1 : 2;
        if (tempIndex < itemsInRow) break;
        tempIndex -= itemsInRow;
        itemsProcessed += itemsInRow;
        rowNumber++;
      }

      const isFullWidthRow = rowNumber % 2 === 0;
      const isFirstInSplitRow = !isFullWidthRow && index === itemsProcessed;

      return (
        <div
          class={`mt-4 w-full ${isFullWidthRow ? 'md:w-full' : 'md:w-[calc(50%-8px)]'} ${isFirstInSplitRow ? 'md:mr-4' : ''} `}
          data-tags={item.tags.join(',')}
        >
          <ScrollReveal>
            <ProjectPreview project={item.project} disableCursor={true} />
          </ScrollReveal>
        </div>
      );
    })}
  </div>

  <ScrollReveal>
    <h2
      class="edge-padding mx-auto mt-30 w-full text-center text-xl leading-tight font-bold md:mt-60 md:w-1/2 md:text-4xl"
    >
      We are not for everyone.
      <br />
      Symbold partners only with visionaries who value design as strategy, not decoration.
    </h2>
  </ScrollReveal>

  <div class="content-padding mt-30 flex items-center justify-center">
    <Button class="w-full md:w-auto" href="/contact"> Work with us </Button>
  </div>

  <div class="content-padding">
    <hr class="mt-30 mb-10 md:mb-30" />
  </div>
</Layout>

<style is:global>
  /* Returning to /work: show restored cards in place instead of fading them in again */
  html.restoring-work-grid .fade-in-scroll {
    transition: none;
  }
</style>

<script>
  import { afterViewTransition } from '../lib/view-transition';

  function toggleProjectVisibility(projectElement: HTMLElement, isVisible: boolean) {
    const scrollAnimationChild = projectElement.querySelector(
      '[data-scroll-animation]'
    ) as HTMLElement;

    if (isVisible) {
      projectElement.style.display = 'block';
      const isInViewport = scrollAnimationChild.getBoundingClientRect().top < window.innerHeight;
      if (isInViewport) {
        scrollAnimationChild?.classList.add('visible');
      } else {
        scrollAnimationChild?.classList.remove('visible');
      }
    } else {
      projectElement.style.display = 'none';
      scrollAnimationChild?.classList.remove('visible');
    }
  }

  function renderProjects(selectedTags: Set<string>) {
    const projectElements = document.querySelectorAll('[data-tags]');

    const { visibleProjects, hiddenProjects } = Array.from(projectElements).reduce(
      (acc, el) => {
        const projectTags = el.getAttribute('data-tags')?.split(',') || [];
        const hasMatchingTag = projectTags.some((tag) => selectedTags.has(tag));
        if (selectedTags.has('all') || hasMatchingTag) {
          acc.visibleProjects.push(el);
        } else {
          acc.hiddenProjects.push(el);
        }
        return acc;
      },
      { visibleProjects: [] as Element[], hiddenProjects: [] as Element[] }
    );

    visibleProjects.forEach((el, index) => {
      let rowNumber = 0;
      let itemsProcessed = 0;
      let tempIndex = index;

      while (tempIndex >= 0) {
        const itemsInRow = rowNumber % 2 === 0 ? 1 : 2;
        if (tempIndex < itemsInRow) break;
        tempIndex -= itemsInRow;
        itemsProcessed += itemsInRow;
        rowNumber++;
      }

      const isFullWidthRow = rowNumber % 2 === 0;
      const isFirstInSplitRow = !isFullWidthRow && index === itemsProcessed;

      if (isFullWidthRow) {
        el.classList.add('md:w-full');
        el.classList.remove('md:w-[calc(50%-8px)]');
      } else {
        el.classList.add('md:w-[calc(50%-8px)]');
        el.classList.remove('md:w-full');
      }

      if (isFirstInSplitRow) {
        el.classList.add('md:mr-4');
      } else {
        el.classList.remove('md:mr-4');
      }

      toggleProjectVisibility(el as HTMLElement, true);
    });
    hiddenProjects.forEach((el) => {
      toggleProjectVisibility(el as HTMLElement, false);
    });
  }

  function getActiveTags() {
    const active = [...document.querySelectorAll('.tag-button[data-active="true"]')];
    return new Set(active.map((btn) => btn.getAttribute('data-tag-id')!));
  }

  // Returning to /work (Back button or "Back to work"): reapply the saved filters and scroll
  // position. Runs inside the page swap, before the browser captures the new page for the view
  // transition; restoring later (on page-load) left Safari showing unrevealed (blank) cards.
  function restoreSavedView() {
    if (!document.querySelector('[data-tags]')) return;

    const { workTags, workScrollY, scrollY: routerScrollY } = history.state ?? {};
    if (workTags && !workTags.includes('all')) {
      const selectedTags = new Set<string>(workTags);
      document.querySelectorAll('.tag-button').forEach((btn) => {
        btn.setAttribute('data-active', String(selectedTags.has(btn.getAttribute('data-tag-id')!)));
      });
      renderProjects(selectedTags);
    }

    // Prefer our own value: ClientRouter's scrollY can be overwritten by a late `scrollend` from
    // the page we just left. Jump instantly; `scroll-behavior: smooth` would animate from the top.
    const top = workScrollY ?? routerScrollY ?? 0;
    if (top > 0) {
      window.scrollTo({ top, behavior: 'instant' });
      // Reveal what is now on screen without waiting for the IntersectionObserver. Do it without the
      // fade: Safari draws the view transition ahead of a running fade, so the cards would dip and
      // fade in a second time once the transition ends.
      document.documentElement.classList.add('restoring-work-grid');
      renderProjects(getActiveTags());
      afterViewTransition().then(() =>
        document.documentElement.classList.remove('restoring-work-grid')
      );
    }

    // Only valid for this return; later scrolling here is tracked by ClientRouter again
    if (workScrollY !== undefined) {
      const { workScrollY: _, ...state } = history.state;
      history.replaceState(state, '');
    }
  }

  restoreSavedView(); // full page loads (e.g. reload)
  document.addEventListener('astro:after-swap', restoreSavedView);

  // Leaving /work through a link: save the scroll position for restoreSavedView
  document.addEventListener('astro:before-preparation', (event) => {
    if (event.navigationType === 'traverse' || !document.querySelector('[data-tags]')) return;
    history.replaceState({ ...history.state, workScrollY: window.scrollY }, '');
  });

  document.addEventListener('astro:page-load', () => {
    const selectedTags = getActiveTags();

    function toggleTag(button: Element) {
      const tagId = button.getAttribute('data-tag-id');
      const isActive = button.getAttribute('data-active') === 'true';

      if (!tagId) return;

      if (tagId === 'all') {
        if (!isActive) {
          // Select "all" and deselect others
          selectedTags.clear();
          selectedTags.add('all');

          document.querySelectorAll('.tag-button').forEach((btn) => {
            const btnTagId = btn.getAttribute('data-tag-id');
            if (btnTagId === 'all') {
              btn.setAttribute('data-active', 'true');
            } else if (btn.getAttribute('data-active') === 'true') {
              btn.setAttribute('data-active', 'false');
            }
          });
        }
      } else {
        if (isActive) {
          // Deselect this tag
          button.setAttribute('data-active', 'false');
          selectedTags.delete(tagId);

          // If no tags selected, reselect "all"
          if (selectedTags.size === 0) {
            selectedTags.add('all');
            const allTag = document.querySelector('[data-tag-id="all"]');
            if (allTag) {
              allTag.setAttribute('data-active', 'true');
            }
          }
        } else {
          // Select this tag
          button.setAttribute('data-active', 'true');
          selectedTags.delete('all');
          selectedTags.add(tagId);

          // Always deselect "all" tag when selecting another tag
          const allTag = document.querySelector('[data-tag-id="all"]');
          if (allTag) {
            allTag.setAttribute('data-active', 'false');
          }
        }
      }

      renderProjects(selectedTags);

      // Keep the filters in this page's history entry so returning here restores the same grid
      history.replaceState({ ...history.state, workTags: [...selectedTags] }, '');
    }

    // Attach click handlers to all tag buttons
    document.querySelectorAll('.tag-button').forEach((button) => {
      button.addEventListener('click', () => toggleTag(button));
    });

    // Remember which history entry opened a project, so its "Back to work" link can go back here
    document.querySelectorAll<HTMLAnchorElement>('[data-tags] a').forEach((link) => {
      link.addEventListener('click', () => {
        sessionStorage.setItem(
          'work-origin',
          JSON.stringify({ path: link.pathname.replace(/\/$/, ''), index: history.state?.index })
        );
      });
    });
  });
</script>
